rules_version = '2';

// Fuer die Sterne-Rangliste (lib/services/firestore_leaderboard_repository.dart):
// jede/r darf die Rangliste lesen, aber nur den eigenen (anonym
// angemeldeten) Eintrag schreiben - sonst koennte jeder fremde
// Punktestaende faelschen. In der Firebase-Konsole unter
// "Firestore Database" -> "Regeln" einfuegen (oder per Firebase-CLI
// deployen: firebase deploy --only firestore:rules).
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 20
        && request.resource.data.stars is int
        && request.resource.data.stars >= 0;
    }
  }
}
